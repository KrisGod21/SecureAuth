# Run npm run setup to create a random local storage key. Never commit .env.
STORAGE_KEY=
PORT=3000
HOST=127.0.0.1
# Optional absolute SQLite path. Empty uses this project's data/students.sqlite.
DB_PATH=
APP_ORIGIN=http://localhost:3000
# HTTPS and Secure cookies are mandatory when NODE_ENV=production.
NODE_ENV=development
# Optional genuine ANU quantum randomness. Empty means honest CSPRNG-only mode.
ANU_QRNG_KEY=
